#!/usr/bin/env bash
#
# Start the workspace's local Solana validator and fund the workspace wallet.
#
# Every workspace runs its own validator instead of reaching for devnet. SOL is
# unlimited and instant, there is no faucet to rate-limit us, and the whole
# first run works with egress switched off, which is what the anonymous tier
# requires. Real devnet is a later, deliberate step, not the dev loop.
#
#   brik-localnet start   boot the validator, wait for it, fund the wallet
#   brik-localnet status  exit 0 if the validator answers
#   brik-localnet stop    kill it

set -euo pipefail

LEDGER="${BRIK_LEDGER:-/workspace/.brik/test-ledger}"
RPC_PORT="${BRIK_RPC_PORT:-8899}"
WALLET="${BRIK_WALLET:-$HOME/.config/solana/id.json}"
AIRDROP_SOL="${BRIK_AIRDROP_SOL:-1000}"
PROGRAMS="/opt/brik/programs"
RPC_URL="http://127.0.0.1:${RPC_PORT}"
LOG="${BRIK_LEDGER_LOG:-/workspace/.brik/validator.log}"
READY_TIMEOUT_SECONDS=60

# Metaplex Token Metadata is the one program the templates need that genesis
# does not carry. SPL Token, Token-2022, the associated token account program,
# and Memo are already there. Verified against Agave 2.1.21.
TOKEN_METADATA_ID="metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s"

is_up() {
  solana --url "$RPC_URL" cluster-version >/dev/null 2>&1
}

start() {
  if is_up; then
    echo "Validator already running on ${RPC_URL}"
    return 0
  fi

  mkdir -p "$(dirname "$LEDGER")" "$(dirname "$LOG")"

  # --reset is not optional. Genesis flags are ignored when a ledger already
  # exists, and --upgradeable-program and --account-dir are ignored with no
  # warning at all, so a resumed ledger would come up missing its programs.
  #
  # Note that --bind-address does not move the RPC, websocket, or faucet
  # listeners: Agave 2.1.21 hardcodes those to 0.0.0.0. Keep the workspace off
  # the host network at the container layer, never by a validator flag.
  local args=(
    --ledger "$LEDGER"
    --reset
    --quiet
    --rpc-port "$RPC_PORT"
    --limit-ledger-size 10000
  )

  if [ -f "${PROGRAMS}/token-metadata.so" ]; then
    args+=(--bpf-program "$TOKEN_METADATA_ID" "${PROGRAMS}/token-metadata.so")
  fi

  solana-test-validator "${args[@]}" >"$LOG" 2>&1 &

  local waited=0
  until is_up; do
    if [ "$waited" -ge "$READY_TIMEOUT_SECONDS" ]; then
      echo "Validator did not start within ${READY_TIMEOUT_SECONDS}s. Last output:" >&2
      tail -20 "$LOG" >&2
      return 1
    fi
    sleep 1
    waited=$((waited + 1))
  done

  solana config set --url "$RPC_URL" >/dev/null

  if [ ! -f "$WALLET" ]; then
    mkdir -p "$(dirname "$WALLET")"
    solana-keygen new --no-passphrase --silent --outfile "$WALLET" >/dev/null
  fi

  solana airdrop "$AIRDROP_SOL" "$(solana-keygen pubkey "$WALLET")" >/dev/null

  echo "Validator ready on ${RPC_URL} after ${waited}s"
  echo "Wallet $(solana-keygen pubkey "$WALLET") funded with $(solana balance)"
}

stop() {
  pkill -f solana-test-validator || true
}

case "${1:-start}" in
  start) start ;;
  status) is_up ;;
  stop) stop ;;
  *)
    echo "usage: brik-localnet [start|status|stop]" >&2
    exit 64
    ;;
esac
