# Absolute origin of the deployed site. Used as metadataBase so the Open Graph
# and Twitter card images resolve to absolute URLs. Falls back to localhost:3000.
NEXT_PUBLIC_SITE_URL=https://brik.dev

# Whether /workspace, /new, and /api/workspace answer at all. Unset means open
# in development and closed in production, so a deployment that loses its
# environment fails shut rather than serving a workspace it cannot start. Set it
# to 1 only where a sandbox provider is reachable and abuse controls exist.
BRIK_WORKSPACE_ENABLED=

# Image every workspace container runs. Build it from infra/toolchain-image.
BRIK_WORKSPACE_IMAGE=brik/solana-toolchain:dev

# Hard lifetime of a workspace container. The container exits on its own after
# this, and the sweeper removes it; shorten it while developing.
BRIK_WORKSPACE_TTL_SECONDS=900

# How many workspaces may run at once, across the whole deployment when a store
# is configured and per process when one is not. Each is a container off a
# 6.11GB image with a validator and a compiler in it. Requests past it are
# turned away with a plain message.
BRIK_MAX_WORKSPACES=4

# What one visitor may spend in an hour. A workspace is a sandbox billed by the
# second and a message is model tokens, so these are two different meters. A
# developer machine is not an anonymous visitor and every local request looks
# like the same one, so raise these locally: `pnpm verify-templates` alone
# starts four workspaces.
BRIK_RUNS_PER_HOUR=5
BRIK_MESSAGES_PER_HOUR=30

# Which deployment a count belongs to. One Upstash database is shared by
# production, previews, and local development, so without this a local run
# occupies production's workspace slots. Defaults to VERCEL_ENV, or "local".
BRIK_LIMITS_NAMESPACE=

# Where those counts live. Without them the limits cannot be enforced, so a
# production build refuses to start a workspace rather than serve without a
# quota; in development the in-process count is used instead. Vercel's Upstash
# integration supplies the KV_ pair; a standalone Upstash database supplies the
# UPSTASH_ pair. Either works.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Salts the hash that identifies a visitor, so the store holds a digest rather
# than an address. Set it to anything long in production.
BRIK_VISITOR_SALT=

# Managed sandbox provider, for workspaces that run anywhere other than a
# developer's own Docker. Get one from https://e2b.dev/dashboard; the free
# Hobby tier is enough to run the bake-off. Never commit the value.
E2B_API_KEY=
