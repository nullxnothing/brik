# Absolute origin of the deployed site. Used as metadataBase so the Open Graph
# and Twitter card images resolve to absolute URLs. Falls back to localhost:3000.
NEXT_PUBLIC_SITE_URL=https://brik.dev

# Image every workspace container runs. Build it from infra/toolchain-image.
BRIK_WORKSPACE_IMAGE=brik/solana-toolchain:dev

# Hard lifetime of a workspace container. The container exits on its own after
# this, and the sweeper removes it; shorten it while developing.
BRIK_WORKSPACE_TTL_SECONDS=900
