{
  "name": "brik",
  "private": true,
  "version": "0.1.0",
  "description": "BRIK — browser-native development platform for Solana",
  "scripts": {
    "dev": "pnpm --filter @brik/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "bakeoff": "pnpm --filter @brik/bakeoff start",
    "verify-templates": "pnpm --filter @brik/verify-templates start",
    "publish-template": "pnpm --filter @brik/toolchain-image start",
    "verify-agent": "pnpm --filter @brik/verify-agent start"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  }
}
